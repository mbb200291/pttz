# Copy to .env.local at the repository root; never commit credentials.
# Explicit dev:local / dev:ptt commands override PTT_TARGET.
PTT_TARGET=local
PTT_LOCAL_HOST=127.0.0.1
PTT_LOCAL_PORT=8888

# Optional credentials for local-only test tools; never use VITE_* names.
PTT_LOCAL_ACCOUNT_1=
PTT_LOCAL_PASSWORD_1=
PTT_LOCAL_ACCOUNT_2=
PTT_LOCAL_PASSWORD_2=
PTT_LOCAL_ACCOUNT_3=
PTT_LOCAL_PASSWORD_3=
