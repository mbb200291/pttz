{
  "name": "@pttzzz/core",
  "version": "0.1.0",
  "pttzzz": {
    "rules": "0.1.x"
  },
  "description": "PTTzzz platform-neutral client, contracts, and reply aggregation core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbb200291/pttzzz.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^4.1.2"
  }
}
