{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.browser.tsbuildinfo",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@pttzzz/core": ["../core/src/index.ts"],
      "@pttzzz/core/internal": ["../core/src/internal.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testSetup.ts"],
  "references": [{ "path": "../core" }]
}
