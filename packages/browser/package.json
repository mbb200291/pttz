{
  "name": "@pttzzz/browser",
  "version": "0.3.0",
  "pttzzz": {
    "core": "^0.3.0",
    "rules": "0.3.x"
  },
  "description": "Official browser gateway for @pttzzz/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbb200291/pttzzz.git",
    "directory": "packages/browser"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src --config vitest.config.ts"
  },
  "dependencies": {
    "@pttzzz/core": "0.3.0",
    "ptt-client": "^0.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^4.1.2"
  }
}
